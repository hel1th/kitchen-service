@startuml
title CJM — Заведение в Авито.Кухне
start

note right
  Управление меню и статусом заведения
  выполняется независимо и в любой момент,
  не привязано к конкретному заказу
end note

partition "Управление меню" {
    :Добавить/удалить категорию меню;
    :Добавить/удалить блюдо;
    :Изменить цену/название/описание блюда;
    :Обновить наличие блюда\n(в наличии / закончилось);
}

partition "Управление статусом заведения" {
    if (Текущий статус заведения?) then (Закрыто)
        :Открыть заведение\n(начать принимать заказы);
    else (Открыто)
        :Закрыть заведение\n(перестать принимать заказы);
    endif
}

partition "Обработка заказа" {
    repeat
        :Получить новый заказ от платформы;
        if (Принять заказ?) then (Да)
            :Статус заказа: Принят;
            :Списать/зарезервировать остатки блюд;
            :Уведомить платформу о статусе;
            :Статус заказа: Готовится;
            :Уведомить платформу о статусе;
            :Статус заказа: Готово;
            :Уведомить платформу о статусе;
        else (Нет)
            :Статус заказа: Отклонён;
            :Уведомить платформу об отклонении;
        endif
    repeat while (Есть новые заказы?) is (Да)
    ->Нет;
}

stop
@enduml